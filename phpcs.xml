<?xml version="1.0"?>
<ruleset
        name="BEAR.Skeleton"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="vendor-bin/tools/vendor/squizlabs/php_codesniffer/phpcs.xsd"
>
    <description>BEAR.Skeleton Coding Standard</description>
    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="80"/>
    <arg name="cache" value=".phpcs-cache"/>

    <!-- PHP version -->
    <config name="php_version" value="{php_version}"/>

    <!-- Ignore warnings, show progress of the run and show sniff names -->
    <arg value="nps"/>

    <!-- Directories to be checked -->
    <file>src</file>
    <file>tests</file>
    <exclude-pattern>*/tests/tmp/*</exclude-pattern>

    <!-- BEAR.Sunday Coding Standard: Doctrine plus the BEAR.Sunday rules -->
    <rule ref="BearSunday">
        <exclude-pattern>*/tests/Fake/*</exclude-pattern>
        <exclude-pattern>*/tmp/*</exclude-pattern>
    </rule>

    <!-- Additional Rules -->
    <rule ref="SlevomatCodingStandard.Classes.PropertySpacing">
        <properties>
            <property name="minLinesCountBeforeWithComment" value="1"/>
            <property name="maxLinesCountBeforeWithComment" value="1"/>
            <property name="maxLinesCountBeforeWithoutComment" value="0"/>
        </properties>
    </rule>
    <!-- Exception declares $message and $code without a type, so a subclass cannot add one -->
    <rule ref="SlevomatCodingStandard.TypeHints.PropertyTypeHint.MissingNativeTypeHint">
        <exclude-pattern>*/Exception/*</exclude-pattern>
    </rule>
</ruleset>
